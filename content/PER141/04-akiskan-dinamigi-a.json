      "type": "term",
      "importance": 2,
      "term": "Bernoulli ilkesi",
      "definition": "Akışta kinetik + basınç enerjisinin korunması; hız artınca lateral basınç düşer (Venturi).",
      "en": "Bernoulli principle",
      "source": "Klabunde: CV Physiology"
    },
    {
      "id": "PER141-0pcahll",
      "type": "term",
      "importance": 2,
      "term": "Laplace yasası",
      "definition": "Duvar gerilimi ∝ basınç × yarıçap; dilate ventrikülde gerilim ve O₂ ihtiyacı artar.",
      "en": "Law of Laplace",
      "source": "Klabunde: CV Physiology"
    },
