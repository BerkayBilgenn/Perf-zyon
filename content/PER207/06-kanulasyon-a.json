      "term": "Drenaj kanülü",
      "en": "Drainage (access) cannula",
      "definition": "Hastadan devreye kan alan kanül; adlandırmada tireden önce yazılır.",
      "source": "ELSO VV 2021"
    },
    {
      "id": "PER207-05ynp80",
      "type": "term",
      "importance": 1,
      "term": "Dönüş kanülü",
      "en": "Return cannula",
