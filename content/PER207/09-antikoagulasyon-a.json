        ]
      },
      "source": "ELSO Antikoagülasyon 2021"
    },
    {
      "id": "PER207-05hov74",
      "type": "compare",
      "importance": 2,
      "title": "İlaçların başlıca uzaklaştırılması",
      "left": {
        "title": "Bivalirudin",
        "points": [
          "Proteolitik yıkım ve renal uzaklaştırma",
          "Staz alanları için ayrı dikkat gerekir"
        ]
      },
      "right": {
        "title": "Argatroban",
        "points": [
          "Başlıca hepatik metabolizma",
          "Karaciğer yetmezliğinde birikme riski"
        ]
      },
      "source": "ELSO Antikoagülasyon 2021"
    },
    {
      "id": "PER207-0vp0w5t",
      "type": "compare",
      "importance": 2,
      "title": "Pıhtılaşma örneği ve izlem",
      "left": {
        "title": "ACT",
        "points": [
          "Tam kanla çalışır",
          "Trombosit ve hematokritten etkilenir"
        ]
      },
      "right": {
        "title": "aPTT",
        "points": [
          "Plazmayla çalışır",
          "Faktör düzeyleri ve reaktiften etkilenir"
        ]
      },
      "source": "ELSO Antikoagülasyon 2021"
    }
  ]
}
