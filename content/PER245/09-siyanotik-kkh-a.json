{
  "topic": "Siyanotik konjenital kalp hastalıkları",
  "cards": [
    {
      "type": "term",
      "importance": 3,
      "term": "Konjenital kalp hastalığı (KKH)",
      "en": "Congenital heart disease",
      "definition": "Doğumdan itibaren mevcut olan kalp veya büyük damarların yapısal gelişim bozukluğu.",
      "source": "PLSVC, Life 2026"
    },
    {
      "type": "term",
      "importance": 2,
      "term": "Siyanoz",
      "en": "Cyanosis",
      "definition": "Deoksijenize hemoglobin artışıyla deri ve mukozanın mavimsi rengi.",
      "source": "UMN Kalp Anatomisi Atlası"
    },
    {
      "type": "term",
      "importance": 2,
      "term": "Fallot tetralojisi (TOF)",
      "en": "Tetralogy of Fallot",
      "definition": "Sağ ventrikül çıkış yolu darlığı, ventriküler septal defekt, ata binen aorta ve sağ ventrikül hipertrofisinin birlikte bulunduğu anomali.",
      "source": "UMN Kalp Anatomisi Atlası"
    },
    {
      "type": "term",
      "importance": 2,
      "term": "Tet nöbeti",
      "en": "Hypercyanotic (tet) spell",
      "definition": "TOF'de ağlama/stresle tetiklenen, kendini besleyen ani siyanoz atağı.",
      "source": "UMN Kalp Anatomisi Atlası"
    },
    {
      "type": "term",
      "importance": 3,
      "term": "Blalock-Taussig(-Thomas) şantı",
      "en": "(Modified) Blalock-Taussig shunt",
      "definition": "Subklavyen arter ile pulmoner arter arasına konan greftle pulmoner akım sağlayan palyatif şant.",
      "source": "UMN Kalp Anatomisi Atlası"
    },
    {
      "type": "term",
      "importance": 1,
      "term": "d-TGA",
      "en": "D-transposition of the great arteries",
      "definition": "Aortanın morfolojik sağ ventrikülden, pulmoner arterin morfolojik sol ventrikülden çıktığı ventriküloarteriyel bağlantı uyumsuzluğu.",
      "source": "UMN Kalp Anatomisi Atlası"
    },
    {
      "type": "term",
      "importance": 2,
      "term": "Arteriyel switch (Jatene)",
      "en": "Arterial switch operation",
      "definition": "Büyük arterlerin yer değiştirilmesi ve koronerlerin buton halinde yeni aortaya aktarılması.",
      "source": "UMN Kalp Anatomisi Atlası"
    },
    {
      "type": "term",
      "importance": 2,
      "term": "LeCompte manevrası",
      "en": "LeCompte maneuver",
      "definition": "Arteriyel switch'te pulmoner arterin yeni aortanın önüne alınması.",
      "source": "UMN Kalp Anatomisi Atlası"
    },
    {
      "type": "term",
      "importance": 3,
      "term": "Balon atriyal septostomi",
      "en": "Balloon atrial septostomy (Rashkind)",
      "definition": "Restriktif foramen ovaleyi balonla genişleterek atriyal karışımı artırma.",
      "source": "UMN Kalp Anatomisi Atlası"
    },
    {
      "type": "term",
      "importance": 2,
      "term": "ccTGA (L-TGA)",
      "en": "Congenitally corrected TGA",
      "definition": "Atriyoventriküler ve ventriküloarteriyel bağlantıların ikisinin de uyumsuz olduğu anomali.",
      "source": "UMN Kalp Anatomisi Atlası"
    },
    {
      "type": "term",
      "importance": 1,
      "term": "Persistan trunkus arteriyozus",
      "en": "Persistent truncus arteriosus",
      "definition": "Sistemik, pulmoner ve koroner dolaşımı besleyen tek arteriyel gövde + büyük VSD.",
      "source": "UMN Kalp Anatomisi Atlası"
    },
    {
      "type": "term",
      "importance": 2,
      "term": "TAPVR",
      "en": "Total anomalous pulmonary venous return",
      "definition": "Tüm pulmoner venlerin sistemik venöz sisteme/sağ atriyuma açılması (suprakardiyak, kardiyak, infradiyafragmatik, mikst).",
      "source": "UMN Kalp Anatomisi Atlası"
    },
    {
      "type": "term",
      "importance": 2,
      "term": "Triküspit atrezisi",
      "en": "Tricuspid atresia",
      "definition": "Triküspit bağlantının olmadığı, sağ ventrikülün yetersiz geliştiği ve venöz kanın atriyal bağlantı üzerinden ilerlediği anomali.",
      "source": "UMN Kalp Anatomisi Atlası"
    },
    {
      "type": "term",
      "importance": 2,
      "term": "Ebstein anomalisi",
      "en": "Ebstein anomaly",
      "definition": "Triküspit septal ve posterior yaprakçıklarının apekse yer değiştirmesi ve \"atriyalize\" sağ ventrikül.",
      "source": "UMN Kalp Anatomisi Atlası"
    },
    {
      "type": "term",
      "importance": 1,
      "term": "Pulmoner atrezi",
      "en": "Pulmonary atresia",
      "definition": "Pulmoner kapağın tamamen kapalı olması; intakt septumlu veya VSD'li form.",
      "source": "UMN Kalp Anatomisi Atlası"
    },
    {
      "type": "term",
      "importance": 3,
      "term": "MAPCA",
      "en": "Major aortopulmonary collateral arteries",
      "definition": "Pulmoner atrezide akciğerleri besleyen, aortadan çıkan büyük kollateraller (unifokalizasyon gerektirebilir).",
      "source": "UMN Kalp Anatomisi Atlası"
    },
    {
      "type": "term",
      "importance": 2,
      "term": "HLHS",
      "en": "Hypoplastic left heart syndrome",
      "definition": "Sol kalp yapılarının sistemik dolaşımı karşılayamayacak kadar yetersiz geliştiği sendrom.",
      "source": "UMN Kalp Anatomisi Atlası"
    },
    {
      "type": "term",
      "importance": 2,
      "term": "Norwood ameliyatı",
      "en": "Norwood procedure",
      "definition": "HLHS evre 1: pulmoner gövde–aorta birleştirme (neo-aorta), atriyal septektomi ve şantla pulmoner akım.",
      "source": "UMN Kalp Anatomisi Atlası"
    },
    {
      "type": "term",
      "importance": 2,
      "term": "Glenn anastomozu",
      "en": "(Bidirectional) Glenn",
      "definition": "VCS'nin sağ pulmoner artere bağlandığı evre 2 kavopulmoner anastomoz.",
      "source": "UMN Kalp Anatomisi Atlası"
    },
    {
      "type": "term",
      "importance": 3,
      "term": "Fontan ameliyatı",
      "en": "Fontan procedure",
      "definition": "Sistemik venöz kanın pulmoner arterlere ventrikül pompası olmadan yönlendirildiği tek ventrikül palyasyonu.",
      "source": "UMN Kalp Anatomisi Atlası"
    },
    {
      "type": "term",
      "importance": 2,
      "term": "DORV",
      "en": "Double outlet right ventricle",
      "definition": "Her iki büyük arterin sağ ventrikülden çıkması.",
      "source": "UMN Kalp Anatomisi Atlası"
    },
    {
      "type": "term",
      "importance": 2,
      "term": "Rastelli ameliyatı",
      "en": "Rastelli procedure",
      "definition": "İntraventriküler baffle ve sağ ventrikül–PA ekstrakardiyak kondüitle onarım.",
      "source": "UMN Kalp Anatomisi Atlası"
    },
    {
      "type": "term",
      "importance": 2,
      "term": "Pulmoner arter bandı",
      "en": "Pulmonary artery banding",
      "definition": "Aşırı pulmoner akımı azaltmak için pulmoner arterin daraltılması.",
      "source": "UMN Kalp Anatomisi Atlası"
    },
    {
      "type": "term",
      "importance": 1,
      "term": "Eritrositoz",
      "en": "Erythrocytosis",
      "definition": "Kronik hipoksemiye yanıt olarak eritrosit artışı.",
      "source": "Konjenital ilişkiler, Europe PMC"
    },
    {
      "type": "term",
      "importance": 2,
      "term": "Kollateral dönüş",
      "en": "Collateral return",
      "definition": "Siyanotik hastada bronşiyal/aortopulmoner kollaterallerden sol kalbe gelen kan.",
      "source": "Kumar, J Thorac Dis 2020"
    },
    {
      "type": "compare",
      "importance": 2,
      "title": "Transpozisyonda bağlantılar",
      "left": {
        "title": "d-TGA",
        "points": [
          "Ventriküloarteriyel diskordans vardır",
          "Paralel dolaşım nedeniyle karışım gerekir"
        ]
      },
      "right": {
        "title": "ccTGA",
        "points": [
          "AV ve ventriküloarteriyel diskordans vardır",
          "Sistemik pompa morfolojik sağ ventriküldür"
        ]
      },
      "source": "UMN Kalp Anatomisi Atlası"
    }
  ]
}
