      "origin": "Lat. ductus + vena"
    },
    {
      "type": "term",
      "importance": 3,
      "source": "OpenStax A&P 2e",
      "term": "Duktus arteriyozus",
      "en": "Ductus arteriosus",
      "definition": "Pulmoner trunkusu inen aortaya bağlayan, 6. ark kökenli fetal damar.",
      "origin": "L. Botallo (eponim)"
    },
    {
      "type": "term",
      "importance": 2,
      "source": "Wikipedia",
      "term": "Fetal hemoglobin",
      "en": "Fetal hemoglobin",
      "definition": "Erişkin hemoglobinine göre oksijen afinitesi daha yüksek olan fetal hemoglobin. Gama zincirlerinin 2,3-BPG bağlaması daha azdır."
    },
    {
      "type": "term",
      "importance": 2,
      "source": "Wikipedia",
      "term": "Ligamentum venozum",
      "en": "Ligamentum venosum",
      "definition": "Duktus venozusun kalıntısı."
    },
    {
      "type": "term",
      "importance": 2,
      "source": "Wikipedia",
      "term": "Ligamentum teres hepatis",
      "en": "Round ligament of the liver",
      "definition": "Umbilikal venin kalıntısı.",
      "origin": "Lat. teres = yuvarlak"
    },
    {
      "type": "term",
      "importance": 1,
      "source": "LITFL fetal dolaşım",
      "term": "Transisyonel dolaşım",
      "en": "Transitional circulation",
      "definition": "Doğumda fetal (paralel/şantlı) dolaşımdan erişkin tipi seri dolaşıma geçiş: pulmoner vasküler direnç düşer, sistemik vasküler direnç artar, şantlar kapanır."
    },
    {
      "type": "term",
      "importance": 2,
      "source": "Merck Manual",
      "term": "Fonksiyonel kapanma",
      "en": "Functional closure",
      "definition": "Bir yapının akımı durduracak şekilde kapanması. Doku düzeyindeki kalıcı kapanmadan önce gerçekleşebilir."
    },
    {
      "type": "term",
      "importance": 2,
      "source": "Merck Manual",
      "term": "PPHN",
      "en": "Persistent pulmonary hypertension of the newborn",
      "definition": "Yüksek fetal pulmoner vasküler direnç'nin sürmesi/geri dönmesi; PFO/PDA'dan sağdan sola şantla oksijene yanıtsız hipoksemi."
    },
    {
      "type": "term",
      "importance": 2,
      "source": "Merck Manual",
      "term": "Alprostadil",
      "en": "Prostaglandin E1",
      "definition": "Duktus-bağımlı lezyonlarda duktusun açık tutulması için kullanılan prostaglandin E1."
    },
    {
      "type": "term",
      "importance": 2,
      "source": "Merck Manual",
      "term": "COX inhibitörleri",
      "en": "Cyclooxygenase inhibitors",
      "definition": "Prostaglandin sentezini baskılayarak prematüre PDA'sını kapatan ilaçlar."
    },
