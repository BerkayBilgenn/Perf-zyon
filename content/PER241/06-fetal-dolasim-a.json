      "origin": "Lat. = yassı kek"
    },
    {
      "type": "term",
      "importance": 2,
      "source": "OpenStax A&P 2e",
      "term": "Umbilikal ven",
      "en": "Umbilical vein",
      "definition": "Plasentadan fetusa oksijenli kanı taşıyan tek ven; kalıntısı ligamentum teres hepatis.",
      "origin": "Lat. umbilicus = göbek"
    },
    {
      "type": "term",
      "importance": 2,
      "source": "OpenStax A&P 2e",
      "term": "Umbilikal arterler",
      "en": "Umbilical arteries",
      "definition": "Fetustan plasentaya oksijeni daha düşük kanı taşıyan damarlar."
    },
    {
      "type": "term",
      "importance": 3,
      "source": "OpenStax A&P 2e",
      "term": "Duktus venozus",
      "en": "Ductus venosus",
