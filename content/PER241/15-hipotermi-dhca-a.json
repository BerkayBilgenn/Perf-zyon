    },
    {
      "type": "term",
      "importance": 2,
      "source": "Groom ve ark. 2005",
      "term": "Düşük akımlı KPB",
      "en": "Low-flow bypass",
      "definition": "Hipotermi sırasında tüm vücuda azaltılmış pompa akımının sürdürüldüğü kardiyopulmoner bypass tekniği."
    },
    {
      "type": "term",
      "importance": 2,
      "source": "Groom ve ark. 2005",
      "term": "SACP",
