      "origin": "α = imidazol iyonlaşma oranı"
    },
    {
      "type": "term",
      "importance": 1,
      "source": "Groom ve ark. 2005",
      "term": "pH-stat",
      "en": "pH-stat",
      "definition": "Kan gazını hastanın sıcaklığına düzeltilmiş değerlerle değerlendiren yaklaşım. Karbondioksit eklenmesi serebral vazodilatasyona katkıda bulunur."
    },
