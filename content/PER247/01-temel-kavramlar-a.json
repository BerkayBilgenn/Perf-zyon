{
  "topic": "Temel kavramlar ve tarihçe",
  "cards": [
    {
      "id": "PER247-0tloavz",
      "type": "term",
      "importance": 3,
      "source": "CDC 2008 (2019 güncellemesi)",
      "term": "Dezenfeksiyon",
      "definition": "Cansız nesnelerde bakteri sporları hariç patojenlerin çoğunun/tamamının yok edilmesi.",
      "en": "Disinfection"
    },
    {
      "id": "PER247-0eztr9b",
      "type": "term",
      "importance": 3,
      "source": "CDC 2008 (2019 güncellemesi)",
      "term": "Sterilizasyon",
      "definition": "Bakteri sporları dâhil **tüm mikrobiyal yaşamı** yok eden veya uzaklaştıran, etkinliği valide edilmiş süreç.",
      "en": "Sterilization"
    },
    {
      "id": "PER247-1ud6exo",
      "type": "term",
      "importance": 2,
      "source": "CDC 2008 (2019 güncellemesi)",
      "term": "Steril",
      "definition": "Canlı mikroorganizmalardan arınmış olma hâlini tanımlar. Bir işlemin sterilite güvencesi olasılık temelli değerlendirilir.",
      "en": "Sterile"
    },
    {
      "id": "PER247-1x0qob6",
      "type": "term",
      "importance": 3,
      "source": "CDC 2008 (2019 güncellemesi)",
      "term": "Temizlik",
      "definition": "Görünür kir, kan, protein ve mikroorganizmaların su + deterjan/enzimle elle veya mekanik uzaklaştırılması.",
      "en": "Cleaning"
    },
    {
      "id": "PER247-0nd4y5v",
      "type": "term",
      "importance": 3,
      "source": "CDC 2008 (2019 güncellemesi)",
      "term": "Dekontaminasyon",
      "definition": "Patojenlerin, nesne güvenle tutulup kullanılabilecek/atılabilecek düzeye kadar uzaklaştırılması/inaktivasyonu (OSHA); DSÖ'de temizlik-dezenfeksiyon-sterilizasyonun şemsiye adı.",
      "en": "Decontamination"
    },
    {
      "id": "PER247-1qb7r4i",
      "type": "term",
      "importance": 2,
      "source": "CDC 2008 (2019 güncellemesi)",
      "term": "Kontaminasyon",
      "definition": "Mikroorganizmalarla gerçek veya potansiyel temas hâli.",
      "en": "Contamination"
    },
    {
      "id": "PER247-06zp3el",
      "type": "term",
      "importance": 1,
      "source": "CDC 2008 (2019 güncellemesi)",
      "term": "Sanitasyon ajanı",
      "definition": "Cansız nesnelerde bakteriyel kontaminasyonu halk sağlığı gereklerine uygun güvenli düzeye indiren ajan.",
      "en": "Sanitizer"
    },
    {
      "id": "PER247-19bgj2l",
      "type": "term",
      "importance": 2,
      "source": "CDC 2008 (2019 güncellemesi)",
      "term": "Germisit",
      "definition": "Mikroorganizmaları (özellikle patojenleri) öldüren ajan; antiseptik ve dezenfektanları kapsar.",
      "en": "Germicide"
    },
    {
      "id": "PER247-10s3f2m",
      "type": "term",
      "importance": 1,
      "source": "CDC 2008 (2019 güncellemesi)",
      "term": "Mikrobisit",
      "definition": "Mikroorganizmaları etkin biçimde öldüren madde.",
      "en": "Microbicide"
    },
    {
      "id": "PER247-1jtkm3w",
      "type": "term",
      "importance": 1,
      "source": "CDC 2008 (2019 güncellemesi)",
      "term": "Antimikrobiyal ajan",
