{
  "topic": "Asepsi, antisepsi ve antiseptikler",
  "cards": [
    {
      "id": "PER247-0c16gvg",
      "type": "term",
      "importance": 3,
      "source": "CDC 2008 (2019 güncellemesi)",
      "term": "Asepsi",
      "definition": "Mikroorganizmalarla **temasın önlenmesi**. Steril malzeme ve alanın korunmasında temel amaçtır.",
      "en": "Asepsis"
    },
    {
      "id": "PER247-1st0m14",
      "type": "term",
      "importance": 2,
      "source": "Aykan, Sterilizasyon 2023",
      "term": "Aseptik",
      "definition": "Mikroorganizma kontaminasyonundan arındırılmış ya da bu kontaminasyondan korunan ortam veya malzemeyi niteleyen terim.",
      "en": "Aseptic"
    },
    {
      "id": "PER247-0ssqn2d",
      "type": "term",
      "importance": 2,
      "source": "Aykan, Sterilizasyon 2023",
      "term": "Septik",
      "definition": "Mikroorganizma içeren veya mikroorganizma bulaşıyla ilişkili ortamı ya da malzemeyi niteleyen terim.",
      "en": "Septic"
    },
    {
      "id": "PER247-0atynwb",
      "type": "term",
      "importance": 3,
      "source": "Aykan, Sterilizasyon 2023",
      "term": "Antisepsi",
      "definition": "Canlı dokudaki mikroorganizmaların uygun kimyasallarla etkisizleştirilmesi veya yok edilmesi işlemi.",
      "en": "Antisepsis"
    },
    {
      "id": "PER247-11lv3pp",
      "type": "term",
      "importance": 3,
      "source": "CDC 2008 (2019 güncellemesi)",
      "term": "Antiseptik",
      "definition": "Canlı doku ve deriye uygulanan germisit.",
      "en": "Antiseptic"
    },
    {
      "id": "PER247-1cw0wqe",
      "type": "term",
      "importance": 3,
      "source": "CDC 2008 (2019 güncellemesi)",
      "term": "Dezenfektan",
      "definition": "Yalnızca cansız nesnelere uygulanan, patojenleri yok eden (sporları öldürmeyebilen) ajan.",
      "en": "Disinfectant"
    },
    {
      "id": "PER247-11q9hmm",
      "type": "term",
      "importance": 2,
      "source": "CDC 2008 (2019 güncellemesi)",
      "term": "Alkol",
      "definition": "Etil veya izopropil alkolün protein denatürasyonuyla gösterdiği germisit etkiye dayanan antiseptik/dezenfektan grubu. **Bakteri sporlarını öldürmez.**",
      "en": "Ethyl/isopropyl alcohol"
    },
    {
      "id": "PER247-08wbirs",
      "type": "term",
      "importance": 2,
      "source": "CDC 2008 (2019 güncellemesi)",
      "term": "İyodofor",
      "definition": "İyotun bir çözündürücü madde veya taşıyıcıyla oluşturduğu germisit kompleks. Povidon-iyot bu grubun bir örneğidir.",
      "en": "Iodophor"
    },
    {
      "id": "PER247-022avvk",
      "type": "term",
      "importance": 2,
      "source": "CDC 2008 (2019 güncellemesi)",
      "term": "Povidon-iyot",
      "definition": "Polivinilpirolidon-iyot kompleksi; en bilinen iyodofor antiseptik.",
      "en": "Povidone-iodine"
    },
    {
      "id": "PER247-0qfds0f",
      "type": "term",
      "importance": 2,
      "source": "WHO 2018",
      "term": "Klorheksidin glukonat",
      "definition": "Cerrahi cilt hazırlığında alkollü formülasyonu önerilen antiseptik. Beyin, meninks, göz ve orta kulakla temasından kaçınılır.",
      "en": "Chlorhexidine gluconate (CHG)"
    },
    {
      "id": "PER247-00jpr2p",
